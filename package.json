{
  "name": "imagegen-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "doctor": "tsx scripts/doctor.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.104.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "json-rpc-2.0": "^1.8.1",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "smol-toml": "^1.9.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "description": "A local creative studio powered by your installed Codex app server and imagegen skill.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pate0304/imagegen-studio.git"
  },
  "bugs": {
    "url": "https://github.com/pate0304/imagegen-studio/issues"
  }
}
